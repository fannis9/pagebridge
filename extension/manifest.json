{
  "manifest_version": 3,
  "name": "Page Bridge",
  "version": "0.10.0",
  "description": "把标签页按需交给本机 AI Agent：native messaging 首选 + WebSocket 回退，逐标签共享 + 域名黑名单，可一键「完全接管」。",
  "permissions": ["tabs", "scripting", "storage", "alarms", "nativeMessaging"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8799/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Page Bridge — 点击管理连接",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
